FROM node:20-alpine AS build-stage

WORKDIR /web_nei

COPY ./package.json ./

COPY ./yarn.lock ./

RUN yarn install

COPY . .

# Vite inlines these at build time (web-nei/.env maps them to VITE_*), so the
# navbar links to the standalone Rally/Gamification services are fixed per image.
ARG ENABLE_RALLY=False
ARG RALLY_URL=
ARG ENABLE_GAMIFICATION=False
ARG GAMIFICATION_URL=
ARG GOOGLE_CALENDAR_API_KEY=

RUN GENERATE_SOURCEMAP=false yarn build

FROM nginx:1.20-alpine

COPY ./nginx/default.conf /etc/nginx/conf.d/default.conf

COPY --from=build-stage /web_nei/build /usr/share/nginx/html

EXPOSE 3000
