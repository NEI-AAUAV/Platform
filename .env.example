# Copy to `.env` (gitignored) and fill in. Read by compose.yml / compose.prod.yml.
# Local development works with none of these set; every variable below is
# optional in dev unless its comment says otherwise.

# --- Extensions -------------------------------------------------------------
# Comma-separated list, e.g. "gala,rally". Empty = no extensions.
ENABLED_EXTENSIONS=

# --- OIDC / Authentik -------------------------------------------------------
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://nei.web.ua.pt/authentik/application/o/nei-platform/.well-known/openid-configuration
# Public base URL used for the redirect_uri; defaults to HOST when empty.
OIDC_REDIRECT_BASE_URL=
# Set to false ONLY for a local Authentik with a self-signed certificate.
# The API refuses to boot with false when ENV=production.
OIDC_VERIFY_SSL=true
AUTHENTIK_URL=https://nei.web.ua.pt/authentik
# Admin API token; without it the /admin endpoints answer 503.
AUTHENTIK_TOKEN=

# --- CMS assets (Directus, in the Infrastructure repo) ----------------------
# Must match Infrastructure's DIRECTUS_PUBLIC_URL (trailing slash optional).
DIRECTUS_PUBLIC_URL=http://localhost/cms/
# Public base of the R2 bucket including Directus's storage root, e.g.
# https://cdn.example.com/cms. Empty = every asset goes through Directus.

# --- Production only (compose.prod.yml) -------------------------------------
# Required when ENV=production; compose fails fast if they are unset.
POSTGRES_PASSWORD=
MONGO_PASSWORD=
IDP_SECRET_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
RECAPTCHA_SECRET_KEY=

# --- Cloudflare R2 (api-family uploads) -------------------------------------
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# --- Misc -------------------------------------------------------------------
MONGO_DB=family
TAG=latest

# Docker socket path mounted into ofelia (Podman users: set to the podman socket).
# DOCKER_SOCK=/var/run/docker.sock
